{% if modes %}
- type: entities
  title: {{ labels.ui.house | to_yaml }}
  state_color: true
  entities:
    - entity: input_select.house_mode
      name: {{ labels.ui.mode | to_yaml }}
    - entity: sensor.house_period
      name: {{ labels.ui.period | to_yaml }}
    - entity: sensor.daylight
      name: {{ labels.ui.daylight | to_yaml }}
{% if not controls.panel %}
{# the times are SETTINGS: with the panel they live on Réglages alone #}
{% for p in modes.periods %}
    - entity: input_datetime.house_period_{{ p.id }}
      name: {{ (labels.ui.period_begins ~ ' — ' ~ p.label) | to_yaml }}
{% endfor %}
{% endif %}
{% endif %}
