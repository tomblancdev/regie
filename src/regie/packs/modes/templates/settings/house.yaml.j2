{% if modes %}
- type: entities
  title: {{ labels.ui.house | to_yaml }}
  entities:
{% for p in modes.periods %}
    - entity: input_datetime.house_period_{{ p.id }}
      name: {{ (labels.ui.period_begins ~ ' — ' ~ p.label) | to_yaml }}
{% endfor %}
{% if controls.presence %}
    - entity: input_boolean.presence_drives_mode
      name: {{ labels.ui.presence | to_yaml }}
{% endif %}
{% endif %}
