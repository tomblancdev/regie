{% set plans = scene_plan(area) | selectattr('renders') | list %}
{% set defaults = defaults_of(area) %}
{% if plans or defaults %}
# rendered by La Régie — {{ area.label }}: scenes by role (pack scenes — rooms/{{ area.id }}.yml, not the UI)
{% if plans %}
script:
{% for p in plans %}
{% set steps = [] %}
{% for r in p.roles %}
{% set data = {} %}
{% for k, v in r.look.items() if k != 'on' %}{% set _ = data.update({k: v}) %}{% endfor %}
{% set step = {'action': r.domain ~ '.turn_' ~ ('on' if r.look.on else 'off'), 'target': {'entity_id': r.entities}} %}
{% if r.look.on and data and r.domain == 'light' %}{% set _ = step.update({'data': data}) %}{% endif %}
{% set _ = steps.append(step) %}
{% endfor %}
{{ {area.id ~ '_' ~ p.id: {
  'alias': area.label ~ ' — ' ~ p.id,
  'description': ('every filled role off' if p.implicit else 'the look by role: ' ~ (p.roles | map(attribute='role') | join(', '))) ~ (' · waiting: ' ~ (p.unfilled | join(', ')) if p.unfilled else '') ~ ' (La Régie, pack scenes)',
  'icon': 'mdi:palette',
  'mode': 'restart',
  'sequence': [{'parallel': steps}],
}} | to_block(2) }}
{% endfor %}
  {{ area.id }}_default:
    alias: {{ (area.label ~ ' — ' ~ labels.ui.default) | to_yaml }}
    description: "what 'on' means now: the scene sensor.{{ area.id }}_default names (La Régie, pack scenes)"
    icon: mdi:palette-outline
    mode: restart
    sequence:
      - action: script.turn_on
        continue_on_error: true
        target:
          entity_id: "script.{{ area.id }}_{{ '{{' }} states('sensor.{{ area.id }}_default') {{ '}}' }}"
{% endif %}
{% if defaults %}
{% set first = (area.scenes | default({}) | list | first) | default('off') %}
{% if controls.panel and modes and defaults_base(area) %}
{% set options = look_options(area) %}

# the settings panel (controls.panel, W3b): the family edits what "on" MEANS
# with a simple form — one select per daylight, one per period (`sun` =
# follow the sun); seeded once from the room's file, the UI owns them after
input_select:
{% for d in ['dark', 'dim', 'bright'] %}
  {{ area.id }}_look_{{ d }}:
    name: {{ (area.label ~ ' — ' ~ labels.ui['look_' ~ d]) | to_yaml }}
    icon: mdi:{{ {'dark': 'weather-night', 'dim': 'weather-sunset', 'bright': 'weather-sunny'}[d] }}
    options:
{% for o in options %}
      - {{ o }}
{% endfor %}
{% endfor %}
{% for period in modes.periods %}
  {{ area.id }}_look_{{ period.id }}:
    name: {{ (area.label ~ ' — ' ~ labels.ui.look_period ~ ' ' ~ period.label) | to_yaml }}
    icon: mdi:clock-outline
    options:
      - sun
{% for o in options %}
      - {{ o }}
{% endfor %}
{% endfor %}

template:
  - sensor:
      - name: {{ area.id }}_default
        unique_id: regie_{{ area.id }}_default
        icon: mdi:palette-swatch-outline
        state: >-
          {{ '{%' }} set p = states('input_select.{{ area.id }}_look_' ~ states('sensor.house_period')) {{ '%}' }}
          {{ '{%' }} if p not in ('sun', 'unknown', 'unavailable') {{ '%}' }}{{ '{{' }} p {{ '}}' }}{{ '{%' }} else {{ '%}' }}{{ '{{' }} states('input_select.{{ area.id }}_look_' ~ states('sensor.daylight')) {{ '}}' }}{{ '{%' }} endif {{ '%}' }}
{% else %}

template:
  - sensor:
      - name: {{ area.id }}_default
        unique_id: regie_{{ area.id }}_default
        icon: mdi:palette-swatch-outline
        state: >-
          {{ '{%' }} set table = {{ defaults | tojson | replace('"', "'") }} {{ '%}' }}
          {{ '{{' }} table.get(states('sensor.house_period'), {}).get(states('sensor.daylight'), '{{ first }}') {{ '}}' }}
{% endif %}
{% endif %}
{% endif %}
