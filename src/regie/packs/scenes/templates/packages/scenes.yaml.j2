{% set plans = scene_plan(area) | selectattr('renders') | list %}
{% set defaults = defaults_of(area) %}
{% if plans or defaults %}
# rendered by La Régie — {{ area.label }}: scenes by role (pack scenes — rooms/{{ area.id }}.yml, not the UI)
{% set drifting = [] %}
{% set drift_switches = [] %}
{% set drift_scripts = [] %}
{% set living = [] %}
{% for p in plans if moving(area, p) %}
{% set _ = drifting.append(p) %}
{% set _ = drift_switches.append('input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift') %}
{% if drift_plan(area, p) %}{% set _ = drift_scripts.append('script.' ~ area.id ~ '_' ~ p.id ~ '_drift') %}{% endif %}
{% if life_plan(area, p) %}{% set _ = living.append(p) %}{% set _ = drift_scripts.append('script.' ~ area.id ~ '_' ~ p.id ~ '_life') %}{% endif %}
{% endfor %}
{% set panel = defaults and controls.panel and modes and defaults_base(area) %}
{% set memory = ['off'] %}
{% for p in plans if p.id != 'off' %}{% set _ = memory.append(p.id) %}{% endfor %}
{% if plans or panel %}
input_select:
{% if plans %}
  # the room REMEMBERS its look (0.17): every look script writes these two —
  # what the room wears now (`off` first, so a fresh helper reads off), and
  # what it wore before. `prev`/`next` walk the file's order from the first;
  # `before` gives the second back (the amp switching off, the hood).
  {{ area.id }}_look:
    name: {{ (area.label ~ ' — ' ~ labels.ui.look_now) | to_yaml }}
    icon: mdi:palette
    options:
{% for o in memory %}
      - {{ o | to_yaml }}
{% endfor %}
  {{ area.id }}_look_before:
    name: {{ (area.label ~ ' — ' ~ labels.ui.look_before) | to_yaml }}
    icon: mdi:history
    options:
{% for o in memory %}
      - {{ o | to_yaml }}
{% endfor %}
{% endif %}
{% if panel %}
{% set options = look_options(area) %}
  # the settings panel (controls.panel, W3b): the family edits what "on" MEANS
  # with a simple form — one select per daylight, one per period (`sun` =
  # follow the sun); seeded once from the room's file, the UI owns them after
{% for d in ['dark', 'dim', 'bright'] %}
  {{ area.id }}_look_{{ d }}:
    name: {{ (area.label ~ ' — ' ~ labels.ui['look_' ~ d]) | to_yaml }}
    icon: mdi:{{ {'dark': 'weather-night', 'dim': 'weather-sunset', 'bright': 'weather-sunny'}[d] }}
    options:
{% for o in options %}
      - {{ o }}
{% endfor %}
{% endfor %}
{% for period in modes.periods %}
  {{ area.id }}_look_{{ period.id }}:
    name: {{ (area.label ~ ' — ' ~ labels.ui.look_period ~ ' ' ~ period.label) | to_yaml }}
    icon: mdi:clock-outline
    options:
      - sun
{% for o in options %}
      - {{ o }}
{% endfor %}
{% endfor %}
{% endif %}

{% endif %}
{% if plans %}
{% if drifting %}
# the kill-switch (H36): a look that MOVES is a look you can stop. Visible on
# the settings view, and the loop below runs only while it is on.
input_boolean:
{% for p in drifting %}
  {{ area.id }}_{{ p.id }}_drift:
    name: {{ (area.label ~ ' — ' ~ p.label) | to_yaml }}
    icon: {{ p.icon }}
{% endfor %}
{% endif %}
script:
{% for p in plans %}
{% set spal = scene_palette(area, p) %}
{% set steps = [] %}
{% if spal %}
{# a look that reads a palette (0.21): every number is a template read at
   recall — the arc, the accent, the white from sensor.house_palette (or a
   named palette's own numbers), the level through the curve and the bulb's
   scatter of the day; the `variables` step below computes them once #}
{% for t in spal.targets %}
{% set step = {'action': t.domain ~ '.turn_' ~ ('on' if t.look.on else 'off'), 'target': {'entity_id': t.entities}} %}
{% if t.look.on and t.data and t.domain == 'light' %}{% set _ = step.update({'data': t.data}) %}{% endif %}
{% set _ = steps.append(step) %}
{% endfor %}
{% else %}
{% for r in p.roles %}
{% set data = {} %}
{% for k, v in r.look.items() if k != 'on' %}{% set _ = data.update({k: v}) %}{% endfor %}
{% set step = {'action': r.domain ~ '.turn_' ~ ('on' if r.look.on else 'off'), 'target': {'entity_id': r.entities}} %}
{% if r.look.on and data and r.domain == 'light' %}{% set _ = step.update({'data': data}) %}{% endif %}
{% set _ = steps.append(step) %}
{% endfor %}
{% endif %}
{% set named = [] %}
{% for r in p.roles %}{% set _ = named.append(r.role ~ ('.' ~ r.place if r.place is defined else '')) %}{% endfor %}
{% set seq = [] %}
{% if drifting %}
{# any look the room takes stops every drift first: a moving ceiling belongs
   to ONE look, and leaving it must leave it (the loop reads the switch) #}
{% set _ = seq.append({'action': 'input_boolean.turn_off', 'target': {'entity_id': drift_switches}}) %}
{# and the loop itself, now: an iteration in flight would paint its walkers over
   the look that follows (read live 2026-09-04: Kowloon's hue on Salle d'arcade) #}
{% set _ = seq.append({'action': 'script.turn_off', 'target': {'entity_id': drift_scripts}}) %}
{% endif %}
{% set current = 'input_select.' ~ area.id ~ '_look' %}
{% set _ = seq.append({'if': [{'condition': 'template', 'value_template': "{{ states('" ~ current ~ "') in " ~ (memory | tojson | replace('"', "'")) ~ " and not is_state('" ~ current ~ "', '" ~ p.id ~ "') }}"}], 'then': [{'action': 'input_select.select_option', 'target': {'entity_id': current ~ '_before'}, 'data': {'option': "{{ states('" ~ current ~ "') }}"}}]}) %}
{% set _ = seq.append({'action': 'input_select.select_option', 'target': {'entity_id': current}, 'data': {'option': p.id}}) %}
{% if kinds.get('motion') %}
{# a look is a hand's act: the sensors let go of the room (the pin is not
   theirs to clear — a hand set it, its next press lifts it) #}
{% set _ = seq.append({'action': 'input_boolean.turn_off', 'target': {'entity_id': 'input_boolean.' ~ area.id ~ '_lit_by_motion'}}) %}
{% endif %}
{% if spal %}{% set _ = seq.append({'variables': spal.variables}) %}{% endif %}
{% set _ = seq.append({'parallel': steps}) %}
{% if moving(area, p) %}
{% set _ = seq.append({'action': 'input_boolean.turn_on', 'target': {'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift'}}) %}
{% if drift_plan(area, p) %}
{% set _ = seq.append({'action': 'script.turn_on', 'target': {'entity_id': 'script.' ~ area.id ~ '_' ~ p.id ~ '_drift'}}) %}
{% endif %}
{% if life_plan(area, p) %}
{% set _ = seq.append({'action': 'script.turn_on', 'target': {'entity_id': 'script.' ~ area.id ~ '_' ~ p.id ~ '_life'}}) %}
{% endif %}
{% endif %}
{{ {area.id ~ '_' ~ p.id: {
  'alias': area.label ~ ' — ' ~ p.label,
  'description': ('every filled role off' if p.implicit else 'the look by role: ' ~ (named | join(', '))) ~ (' · waiting: ' ~ (p.unfilled | join(', ')) if p.unfilled else '') ~ (' · tags: ' ~ (p.tags | join(', ')) if p.tags else '') ~ ' (La Régie, pack scenes)',
  'icon': p.icon,
  'mode': 'restart',
  'sequence': seq,
}} | to_block(2) }}
{% endfor %}
{% for p in drifting if drift_plan(area, p) %}
{% set d = drift_plan(area, p) %}
{% set walk = [] %}
{# A HAND'S OFF ENDS THE WALK (0.25.5, read live: "the flow makes them come up
   when put off"): a colour command turns a bulb on, so a walker is painted only
   while it is ON — a remote, a tile or the motion's timeout that switched it
   off is obeyed —, and when every walker is off the look's switch goes off #}
{% set walker_ids = d.walkers | map(attribute='entity') | list %}
{% set _ = walk.append({'if': [{'condition': 'template', 'value_template': '{{ ' ~ (walker_ids | tojson | replace('"', "'")) ~ " | map('states') | select('eq', 'on') | list | count == 0 }}"}], 'then': [{'action': 'input_boolean.turn_off', 'target': {'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift'}}, {'stop': 'every bulb of the look is off — a hand ended the walk'}]}) %}
{% for w in d.walkers %}
{% set act = {'action': 'light.turn_on', 'target': {'entity_id': w.entity}, 'data': {'hs_color': [w.hue, d.saturation], 'transition': d.step}} %}
{% set conds = [{'condition': 'state', 'entity_id': w.entity, 'state': 'on'}] %}
{% if w.gate is not none %}
{# a candidate of a palette look (0.21): it walks only on a day that picked it #}
{% set _ = conds.append({'condition': 'template', 'value_template': '{{ room.alive[' ~ w.gate ~ '] }}'}) %}
{% endif %}
{% set _ = walk.append({'if': conds, 'then': [act]}) %}
{% set _ = walk.append({'delay': {'milliseconds': ((d.step * 1000) / (d.walkers | length)) | round | int}}) %}
{% endfor %}
{% set dseq = [] %}
{% if d.palette %}{% set _ = dseq.append({'variables': d.palette.variables}) %}{% endif %}
{% set _ = dseq.append({'repeat': {'while': [{'condition': 'state', 'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift', 'state': 'on'}], 'sequence': walk}}) %}
{{ {area.id ~ '_' ~ p.id ~ '_drift': {
  'alias': area.label ~ ' — ' ~ p.label ~ ' ↻',
  'description': 'the sustained walk of ' ~ p.label ~ ' — ' ~ (d.walkers | length) ~ ' × hue ' ~ ((d.lo ~ '-' ~ d.hi ~ '°') if d.lo is not none else "the palette's arc, read from sensor.house_palette at every step; a candidate walks only on a day that picked it") ~ ', a colour every ' ~ d.step ~ ' s each, every one on its own clock. Stateless: a hue is a function of the time, so a restart resumes mid-stride. Brightness is never sent — the look set it, and a level command aborts a colour ramp in the bulb (La Régie, pack scenes)',
  'icon': p.icon,
  'mode': 'restart',
  'sequence': dseq,
}} | to_block(2) }}
{% endfor %}
{% for p in living %}
{% set l = life_plan(area, p) %}
{# LIFE (0.22): a random shape on a random bulb, now and then, while the look
   holds — the pace and the shapes are the palette's (the sensor's for `today`:
   none on a day without life), the bulb is drawn from the pool the ENVELOPE
   allows: a level shape anywhere, a colour shape on a still bulb alone (never a
   roamer; a candidate only on a day that left it still), never the same bulb
   twice in a row. Its switch is the look's own ↻ #}
{% set shapes_expr = "(pal.life.shapes if pal.life else [])" if l.live else (l.shapes | tojson | replace('"', "'")) %}
{% set every_expr = "pal.life.every" if l.live else (l.every | tojson) %}
{# a `set` inside a `for` is the loop's own (0.22.3): the still pool grows on a namespace #}
{% set pick = "{% set shape = " ~ shapes_expr ~ " | random %}"
  ~ "{% set ns = namespace(still=" ~ (l.still | tojson | replace('"', "'")) ~ ", on=[]) %}"
  ~ "{% for e, k in " ~ (l.gated | map('list') | list | tojson | replace('"', "'")) ~ " %}{% if not room.alive[k] %}{% set ns.still = ns.still + [e] %}{% endif %}{% endfor %}"
  ~ "{% set pool = ns.still if shape in " ~ (l.colour_shapes | tojson | replace('"', "'")) ~ " else " ~ (l.any | tojson | replace('"', "'")) ~ " %}"
  ~ "{% set ns.on = [] %}{% for e in pool %}{% if is_state(e, 'on') %}{% set ns.on = ns.on + [e] %}{% endif %}{% endfor %}"
  ~ "{% set pool = ns.on | reject('eq', last) | list or ns.on %}"
  ~ "{{ {'shape': shape, 'bulb': (pool | random) if pool else ''} }}" %}
{% set lseq = [{'variables': l.variables}] %}
{% if l.live %}
{% set _ = lseq.append({'condition': 'template', 'value_template': '{{ pal.life is not none }}'}) %}
{% endif %}
{% set _ = lseq.append({'variables': {'last': ''}}) %}
{% set _ = lseq.append({'repeat': {'while': [{'condition': 'state', 'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift', 'state': 'on'}], 'sequence': [
  {'delay': {'seconds': '{{ range(' ~ every_expr ~ '[0] | int, ' ~ every_expr ~ '[1] | int + 1) | random }}'}},
  {'condition': 'state', 'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift', 'state': 'on'},
  {'if': [{'condition': 'template', 'value_template': '{{ ' ~ (l.any | tojson | replace('"', "'")) ~ " | map('states') | select('eq', 'on') | list | count == 0 }}"}], 'then': [{'action': 'input_boolean.turn_off', 'target': {'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift'}}, {'stop': 'every bulb of the look is off — a hand ended the look'}]},
  {'variables': {'sign': pick}},
  {'if': [{'condition': 'template', 'value_template': "{{ sign.bulb != '' }}"}], 'then': [
    {'action': 'script.fx_{{ sign.shape }}', 'data': {'target': ['{{ sign.bulb }}']}},
    {'variables': {'last': '{{ sign.bulb }}'}},
  ]},
]}}) %}
{{ {area.id ~ '_' ~ p.id ~ '_life': {
  'alias': area.label ~ ' — ' ~ p.label ~ ' ✦',
  'description': 'the life of ' ~ p.label ~ ' — a random shape (' ~ (l.shapes | join(', ')) ~ ') on a random bulb, ' ~ l.every[0] ~ '-' ~ l.every[1] ~ ' s apart, never the same bulb twice in a row; a colour shape lands on a still bulb alone' ~ (' — the sensor says whether today has life' if l.live else '') ~ ' (La Régie, pack scenes)',
  'icon': p.icon,
  'mode': 'restart',
  'sequence': lseq,
}} | to_block(2) }}
{% endfor %}
  {{ area.id }}_default:
    alias: {{ (area.label ~ ' — ' ~ labels.ui.default) | to_yaml }}
    description: "what 'on' means now: the scene sensor.{{ area.id }}_default names (La Régie, pack scenes)"
    icon: mdi:palette-outline
    mode: restart
    sequence:
      # the look's own service, not script.turn_on: this waits for the look to
      # finish, so a caller that marks the room after it (the sensors) never
      # races the look's own writes (0.17)
      - action: "script.{{ area.id }}_{{ '{{' }} states('sensor.{{ area.id }}_default') {{ '}}' }}"
        continue_on_error: true
{% if drifting %}

# the switch is the ONLY truth about a sustained walk: turning it on starts the
# loop, and Home Assistant coming back up starts it again. Without this the
# helper reads `on` after a restart — or after a converge, which reloads the
# scripts — while nothing is walking: a look frozen and claiming to move.
automation:
{% for p in drifting %}
{{ [{
  'id': 'regie_' ~ area.id ~ '_' ~ p.id ~ '_drift',
  'alias': area.label ~ ' — ' ~ p.label ~ ' ↻',
  'description': 'starts the sustained walk of ' ~ p.label ~ ' whenever its switch is on — at a restart, and when a hand turns it back on (La Régie, pack scenes)',
  'mode': 'single',
  'triggers': [
    {'trigger': 'homeassistant', 'event': 'start'},
    {'trigger': 'state', 'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift', 'to': 'on'},
  ],
  'conditions': [{'condition': 'state', 'entity_id': 'input_boolean.' ~ area.id ~ '_' ~ p.id ~ '_drift', 'state': 'on'}],
  'actions': [{'action': 'script.turn_on', 'target': {'entity_id': 'script.' ~ area.id ~ '_' ~ p.id ~ '_drift'}}],
}] | to_block(0) }}
{% endfor %}
{% endif %}
{% endif %}
{% if defaults %}
{% set first = (area.scenes | default({}) | list | first) | default('off') %}
{# « Palette du jour » is a state (0.26): while the house switch is on, "on"
   means the palette in a room that has its part — every path that lights a
   room reads this sensor (the motion light, a remote's on, the power return) #}
{% set part = controls.palette and (plans | selectattr('id', 'eq', 'today') | list) %}
{% set today_prefix = "{% if is_state('input_boolean.house_palette', 'on') %}today{% else %}" %}
{% if panel %}

template:
  - sensor:
      - name: {{ area.id }}_default
        unique_id: regie_{{ area.id }}_default
        icon: mdi:palette-swatch-outline
        state: >-
{% if part %}          {{ today_prefix }}
{% endif %}          {{ '{%' }} set p = states('input_select.{{ area.id }}_look_' ~ states('sensor.house_period')) {{ '%}' }}
          {{ '{%' }} if p not in ('sun', 'unknown', 'unavailable') {{ '%}' }}{{ '{{' }} p {{ '}}' }}{{ '{%' }} else {{ '%}' }}{{ '{{' }} states('input_select.{{ area.id }}_look_' ~ states('sensor.daylight')) {{ '}}' }}{{ '{%' }} endif {{ '%}' }}
{% if part %}          {{ '{%' }} endif {{ '%}' }}
{% endif %}
{% else %}

template:
  - sensor:
      - name: {{ area.id }}_default
        unique_id: regie_{{ area.id }}_default
        icon: mdi:palette-swatch-outline
        state: >-
{% if part %}          {{ today_prefix }}
{% endif %}          {{ '{%' }} set table = {{ defaults | tojson | replace('"', "'") }} {{ '%}' }}
          {{ '{{' }} table.get(states('sensor.house_period'), {}).get(states('sensor.daylight'), '{{ first }}') {{ '}}' }}
{% if part %}          {{ '{%' }} endif {{ '%}' }}
{% endif %}
{% endif %}
{% endif %}
{% endif %}
