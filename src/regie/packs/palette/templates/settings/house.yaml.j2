{% if controls.palette %}
{% set h = palette.house %}
- type: entities
  title: {{ labels.ui.palette | to_yaml }}
  entities:
    - entity: input_select.house_palette
      name: {{ labels.ui.palette | to_yaml }}
    - entity: input_datetime.house_palette_turns
      name: {{ labels.ui.palette_turns | to_yaml }}
    - entity: input_button.house_palette_another
      name: {{ labels.ui.palette_another | to_yaml }}
    - entity: input_boolean.house_palette_repaint
      name: {{ labels.ui.palette_repaint | to_yaml }}
{# L'ATELIER DES PALETTES (0.25): a window that opens from this row - every part
   of a palette, the day's rules, the names; the plain rows left with it. Since
   0.42 the kept palettes are documents the card reads and writes through the
   component's websocket commands, and since 0.43 the day's rules are one more:
   no slot list to hand it, and no helper name either #}
- type: custom:regie-palette-atelier
  select: input_select.house_palette
  auto_label: {{ palette.options[0].label | to_yaml }}
  salt: {{ h.salt }}
  rules:
    whites: {{ h.whites | tojson }}
  named:
{% for n in h.named %}
    - id: {{ n.id }}
      label: {{ n.label | to_yaml }}
      palette: {{ n.palette | tojson }}
{% endfor %}
  shapes: {{ h.shapes | tojson }}
  labels:
{% for k, v in h.labels.items() %}
    {{ k }}: {{ v | to_yaml }}
{% endfor %}
{% endif %}
