# rendered by La Régie — the palette (pack palette, 0.20 → 0.43): ONE value every
# look may read, sensor.house_palette. The select says which source fills it:
# Auto = the day's draw within the day's rules (the files', until a hand moves
# them in the Atelier — a document in the component's store then, and the files'
# again the moment `regie pull` writes them), a palette named in fx.yml, or a
# palette KEPT on the phone under a free name.
#
# WHAT LEFT THIS FILE AT 0.42 AND 0.43 (the audit's V8a and V8b): a kept
# palette was seventeen helpers in one of eight numbered slots, the sensor a
# two-hundred-line generated template, and the day's rules twenty-one helpers
# more. All three are the COMPONENT's now — the documents live in
# `.storage/regie.palettes` behind five websocket commands the Atelier calls,
# and the sensor is computed in Python from the arithmetic the engine reads by
# path. The block `regie: palette:` below is what only the FILES can say.
# WHAT STAYS HERE is the family's own five controls and nothing else: the
# select, « Change à », « Une autre », « Repeint les pièces » and the switch
# « Palette du jour » — with the roll behind « Une autre » and the two
# automations that repaint.
{% set h = palette.house %}
regie:
  # ONE JSON SCALAR, not a YAML block: Home Assistant merges a package's config
  # recursively and passes every LIST it meets through `cv.remove_falsy`, so
  # `avoid: [0, 60]` would arrive `[60]` and `alive: [0, all]` would arrive
  # `[all]` (config.py `_recursive_merge`, read at the source). A scalar crosses
  # the merge untouched — the component parses it itself.
  palette: |
{{ palette.config | indent(4, first=True) }}
input_select:
  house_palette:
    name: {{ labels.ui.palette | to_yaml }}
    icon: mdi:palette
    options:
{% for opt in palette.options %}
      - {{ opt.label | to_yaml }}
{% endfor %}
input_datetime:
  house_palette_turns:
    name: {{ labels.ui.palette_turns | to_yaml }}
    has_date: false
    has_time: true
    icon: mdi:clock-outline
input_boolean:
  # « Repeint les pièces » (0.23, born on): the hour, the roll or the select
  # repaint the rooms LIT in a palette look — and never turn anything on
  house_palette_repaint:
    name: {{ labels.ui.palette_repaint | to_yaml }}
    icon: mdi:format-paint
{% if h.chip %}
  # « Palette du jour » is a STATE (0.26, Tom: "it should simply set the state
  # but the lights up and down stay manual or via automations"): while on,
  # "on" means the palette in every room that has its part — the room's
  # default sensor says `today` (pack scenes); never a light turned on or off
  house_palette:
    name: {{ labels.ui.palette_today | to_yaml }}
    icon: mdi:palette-swatch
{% endif %}
counter:
  house_palette_roll:
    name: {{ labels.ui.palette_roll | to_yaml }}
    icon: mdi:dice-multiple
    initial: 0
    step: 1
    restore: true
input_button:
  house_palette_another:
    name: {{ labels.ui.palette_another | to_yaml }}
    icon: mdi:dice-multiple
automation:
  # « Une autre »: the roll moves, the day's draw changes — for the day (La Régie, pack palette)
  - id: regie_house_palette_another
    alias: {{ (labels.ui.palette ~ ' — ' ~ labels.ui.palette_another) | to_yaml }}
    description: the roll behind « Une autre » — the day's palette is drawn again, and stays until the next press or the next day (La Régie, pack palette)
    mode: single
    triggers:
      - trigger: state
        entity_id: input_button.house_palette_another
        not_from: [unavailable]
    actions:
      - action: counter.increment
        target:
          entity_id: counter.house_palette_roll
{% if h.repaint %}
  # « Repeint les pièces » (0.23): when the palette changes — the hour, the roll,
  # the select — every room LIT in a look that reads it takes it again; a dark
  # room stays dark, a room in another look is untouched (H32's clause, said)
  - id: regie_house_palette_repaint
    alias: {{ (labels.ui.palette ~ ' — ' ~ labels.ui.palette_repaint) | to_yaml }}
    description: the rooms lit in a palette look take the new palette when the sensor changes; nothing is turned on (La Régie, pack palette)
    mode: queued
    triggers:
      # the attribute is a dict: a `not_from` on it made the listener throw on
      # every change and the repaint never ran (read live, 0.23.0)
      - trigger: state
        entity_id: sensor.house_palette
        attribute: palette
    conditions:
      - condition: state
        entity_id: input_boolean.house_palette_repaint
        state: "on"
    actions:
      - parallel:
{% for r in h.repaint %}
          - if:
              - condition: template
                value_template: "{{ '{{' }} states('input_select.{{ r.room }}_look') in {{ r.looks | tojson | replace('"', "'") }} and is_state('light.{{ r.room }}_lights', 'on') {{ '}}' }}"
            then:
              - action: "script.{{ r.room }}_{{ '{{' }} states('input_select.{{ r.room }}_look') {{ '}}' }}"
                continue_on_error: true
{% endfor %}
{% endif %}
{% if h.flip %}
  # « Palette du jour » flips (0.26): a room LIT in a default look takes its
  # new default — the palette when the switch comes on, the period's look when
  # it goes off; a room in a named look is untouched, nothing is turned on or
  # off (H32's clause). The rooms with a part, their defaults and `today`.
  - id: regie_house_palette_flip
    alias: {{ (labels.ui.palette ~ ' — ' ~ labels.ui.palette_today) | to_yaml }}
    description: the switch « Palette du jour » flips — every room lit in one of its default looks (or the palette) takes what "on" means now; nothing is turned on or off (La Régie, pack palette)
    mode: queued
    triggers:
      - trigger: state
        entity_id: input_boolean.house_palette
        to: ["on", "off"]
        not_from: [unavailable, unknown]
    actions:
      - parallel:
{% for r in h.flip %}
          - if:
              - condition: template
                value_template: "{{ '{{' }} is_state('light.{{ r.room }}_lights', 'on') and states('input_select.{{ r.room }}_look') in {{ r.looks | tojson | replace('"', "'") }} {{ '}}' }}"
            then:
              - action: script.{{ r.room }}_default
                continue_on_error: true
{% endfor %}
{% endif %}
