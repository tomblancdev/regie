{% set lights = kinds.get('light', []) %}
{% set motions = kinds.get('motion', []) %}
{% set watched = area_things | selectattr('kind', 'in', ['light', 'plug', 'switch', 'remote', 'motion']) | list %}
{% set parking = house.parking(area) %}
{% if lights %}
# rendered by La Régie — {{ area.label }}: lighting (pack lighting)
homeassistant:
  customize:
    light.{{ area.id }}_lights:
      friendly_name: {{ (area.label ~ ' — ' ~ labels.ui.lights) | to_yaml }}
    sensor.{{ area.id }}_offline:
      friendly_name: {{ (area.label ~ ' — ' ~ labels.ui.offline) | to_yaml }}

{% set role_specs = declared_roles(area) %}
{% for role, rthings in roles.items() %}
{% set rl = rthings | selectattr('kind', 'equalto', 'light') | list %}
{% if rl and (rl | length) == (rthings | length) %}
    light.{{ area.id }}_{{ role }}:
      friendly_name: {{ (area.label ~ ' — ' ~ (role_specs[role].label | default(role))) | to_yaml }}
{% for g in layout_groups(area, role) %}
{# `or`, never `| default()`: a dict's .get returns None for a place the room
   has not named, and Jinja's default() only replaces the UNDEFINED #}
{% set role_label = role_specs[role].label | default(role) %}
{% set place = place_labels(area, role).get(g.prefix) or (role_label ~ ' ' ~ g.prefix) %}
    light.{{ g.id }}:
      friendly_name: {{ (area.label ~ ' — ' ~ place) | to_yaml }}
{% endfor %}
{% endif %}
{% endfor %}

light:
  - platform: group
    name: {{ area.id }}_lights
    unique_id: regie_{{ area.id }}_lights
    entities:
{% for t in lights %}
      - {{ entity(t) }}
{% endfor %}
{% for role, rthings in roles.items() %}
{% set rl = rthings | selectattr('kind', 'equalto', 'light') | list %}
{% if rl and (rl | length) == (rthings | length) %}
  # the role's group — what a scene or an effect aims at (home.yml `role:`)
  - platform: group
    name: {{ area.id }}_{{ role }}
    unique_id: regie_{{ area.id }}_{{ role }}
    entities:
{% for t in rl %}
      - {{ entity(t) }}
{% endfor %}
{% for g in layout_groups(area, role) %}
  # the layout's {{ g.prefix }} places ({{ g.places | join(', ') }}), the ones filled
  - platform: group
    name: {{ g.id }}
    unique_id: regie_{{ g.id }}
    entities:
{% for t in g.things %}
      - {{ entity(t) }}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}


# the room's health (0.10) — the number on its settings page. Every id counted
# is one the house minted itself (`light.<thing>`): nothing is guessed, so this
# can never count a name that never existed. A light Home Assistant does not
# know yet reads `unknown` and counts, which is exactly the truth wanted here.
template:
  - sensor:
      - name: {{ area.id }}_offline
        unique_id: regie_{{ area.id }}_offline
        icon: mdi:lightbulb-alert-outline
        state: >-
          {{ '{%' }} set ns = namespace(n=0) {{ '%}' }}
{% for t in lights if entity(t) %}
          {{ '{%' }} if states('{{ entity(t) }}') in ['unavailable', 'unknown'] {{ '%}' }}{{ '{%' }} set ns.n = ns.n + 1 {{ '%}' }}{{ '{%' }} endif {{ '%}' }}
{% endfor %}
          {{ '{{' }} ns.n {{ '}}' }}

{% if not parking %}
{% if motions %}
# the sensors' three helpers (0.17): the family's switch, the pin a hand sets
# (the sensors stand back until its next press), and the sensors' own mark on
# the room — every look script clears it, so a hand's room is never switched
# off by the clock of a sensor
input_boolean:
  {{ area.id }}_motion:
    name: {{ (area.label ~ ' — ' ~ labels.ui.motion_switch) | to_yaml }}
    icon: mdi:motion-sensor
  {{ area.id }}_pinned:
    name: {{ (area.label ~ ' — ' ~ labels.ui.pinned) | to_yaml }}
    icon: mdi:pin
  {{ area.id }}_lit_by_motion:
    name: {{ (area.label ~ ' — ' ~ labels.ui.lit_by_motion) | to_yaml }}
    icon: mdi:motion-sensor

{% endif %}
{% if motions or controls.silent or (controls.restore_default and lights) %}
automation:
{% endif %}
{% if motions %}
{% set hold = house.motion_hold(area) %}
  # the room SENSES (0.17, behaviour motion_light — one automation per room, on
  # its occupancy signal, never one per sensor): when someone comes and the
  # room is dark and unlit, its default look; when the room clears ({{ hold }}
  # after the last sensor, the signal's own hold), off — only if the sensors lit
  # it. A room a hand lit is a hand's room; a pinned room is left alone both
  # ways; the switch is the family's (H36).
  - id: regie_{{ area.id }}_motion
    alias: {{ (area.label ~ ' — ' ~ labels.ui.motion_switch) | to_yaml }}
    description: "the room senses: script.{{ area.id }}_default when binary_sensor.{{ area.id }}_occupied comes on while {{ area.id }}_dark says so and nothing is lit; off when it clears, if the sensors lit it (La Régie, pack lighting, behaviour motion_light)"
    mode: queued
    triggers:
      - trigger: state
        entity_id: binary_sensor.{{ area.id }}_occupied
        to: "on"
        id: occupied
      - trigger: state
        entity_id: binary_sensor.{{ area.id }}_occupied
        to: "off"
        id: cleared
    conditions:
      - condition: state
        entity_id: input_boolean.{{ area.id }}_motion
        state: "on"
      - condition: state
        entity_id: input_boolean.{{ area.id }}_pinned
        state: "off"
    actions:
      - choose:
          - conditions:
              - condition: trigger
                id: occupied
              - condition: state
                entity_id: binary_sensor.{{ area.id }}_dark
                state: "on"
              - condition: state
                entity_id: light.{{ area.id }}_lights
                state: "off"
            sequence:
              - action: script.{{ area.id }}_default
              - action: input_boolean.turn_on
                target:
                  entity_id: input_boolean.{{ area.id }}_lit_by_motion
          - conditions:
              - condition: trigger
                id: cleared
              - condition: state
                entity_id: input_boolean.{{ area.id }}_lit_by_motion
                state: "on"
            sequence:
              - action: script.{{ area.id }}_off
{% endif %}
{% if controls.restore_default and kinds.get('light', []) %}
  # a light back from power takes the room's DEFAULT look, never its last
  # state (controls.restore_default, W3b: "default on first startup")
  - id: regie_{{ area.id }}_restore_default
    alias: {{ (area.label ~ ' — ' ~ labels.ui.default) | to_yaml }}
    description: a light of this room came back from power (the wall switch, an outage) — the room takes its default look (La Régie, controls.restore_default)
    mode: restart
    triggers:
{% for t in kinds.get('light', []) if entity(t) %}
      - trigger: state
        entity_id: {{ entity(t) }}
        from: unavailable
        to: 'on'
{% endfor %}
    actions:
      - action: script.turn_on
        target:
          entity_id: script.{{ area.id }}_default
{% endif %}
{% if controls.silent %}
  - id: regie_{{ area.id }}_silent
    alias: {{ (area.label ~ ' — ' ~ labels.ui.silent) | to_yaml }}
    description: a thing of this room unavailable for an hour (La Régie, pack lighting)
    mode: queued
    triggers:
      - trigger: state
        entity_id:
{% for t in watched if entity(t) %}
          - {{ entity(t) }}
{% endfor %}
        to: unavailable
        for: "01:00:00"
    actions:
      - action: persistent_notification.create
        data:
          notification_id: "regie_silent_{{ '{{ trigger.entity_id }}' }}"
          title: {{ area.label | to_yaml }}
          message: "{{ '{{ trigger.to_state.name }}' }} {{ labels.ui.silent }}"
{% endif %}
{% endif %}
{% endif %}
