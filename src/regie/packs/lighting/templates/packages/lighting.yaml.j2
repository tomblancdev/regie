{% set lights = kinds.get('light', []) %}
{% set motions = kinds.get('motion', []) %}
{% set watched = area_things | selectattr('kind', 'in', ['light', 'plug', 'switch', 'remote', 'motion']) | list %}
{% set parking = house.parking(area) %}
{% if lights %}
# rendered by La Régie — {{ area.label }}: lighting (pack lighting)
homeassistant:
  customize:
    light.{{ area.id }}_lights:
      friendly_name: {{ (area.label ~ ' — ' ~ labels.ui.lights) | to_yaml }}
    sensor.{{ area.id }}_offline:
      friendly_name: {{ (area.label ~ ' — ' ~ labels.ui.offline) | to_yaml }}

{% set role_specs = declared_roles(area) %}
{% for role, rthings in roles.items() %}
{% set rl = rthings | selectattr('kind', 'equalto', 'light') | list %}
{% if rl and (rl | length) == (rthings | length) %}
    light.{{ area.id }}_{{ role }}:
      friendly_name: {{ (area.label ~ ' — ' ~ (role_specs[role].label | default(role))) | to_yaml }}
{% for g in layout_groups(area, role) %}
    light.{{ g.id }}:
      friendly_name: {{ (area.label ~ ' — ' ~ (role_specs[role].label | default(role)) ~ ' ' ~ g.prefix) | to_yaml }}
{% endfor %}
{% endif %}
{% endfor %}

light:
  - platform: group
    name: {{ area.id }}_lights
    unique_id: regie_{{ area.id }}_lights
    entities:
{% for t in lights %}
      - {{ entity(t) }}
{% endfor %}
{% for role, rthings in roles.items() %}
{% set rl = rthings | selectattr('kind', 'equalto', 'light') | list %}
{% if rl and (rl | length) == (rthings | length) %}
  # the role's group — what a scene or an effect aims at (home.yml `role:`)
  - platform: group
    name: {{ area.id }}_{{ role }}
    unique_id: regie_{{ area.id }}_{{ role }}
    entities:
{% for t in rl %}
      - {{ entity(t) }}
{% endfor %}
{% for g in layout_groups(area, role) %}
  # the layout's {{ g.prefix }} places ({{ g.places | join(', ') }}), the ones filled
  - platform: group
    name: {{ g.id }}
    unique_id: regie_{{ g.id }}
    entities:
{% for t in g.things %}
      - {{ entity(t) }}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}


# the room's health (0.10) — the number on its settings page. Every id counted
# is one the house minted itself (`light.<thing>`): nothing is guessed, so this
# can never count a name that never existed. A light Home Assistant does not
# know yet reads `unknown` and counts, which is exactly the truth wanted here.
template:
  - sensor:
      - name: {{ area.id }}_offline
        unique_id: regie_{{ area.id }}_offline
        icon: mdi:lightbulb-alert-outline
        state: >-
          {{ '{%' }} set ns = namespace(n=0) {{ '%}' }}
{% for t in lights if entity(t) %}
          {{ '{%' }} if states('{{ entity(t) }}') in ['unavailable', 'unknown'] {{ '%}' }}{{ '{%' }} set ns.n = ns.n + 1 {{ '%}' }}{{ '{%' }} endif {{ '%}' }}
{% endfor %}
          {{ '{{' }} ns.n {{ '}}' }}

{% if not parking %}
{% if motions or controls.silent or (controls.restore_default and lights) %}
automation:
{% endif %}
{% for m in motions %}
{% set targets = m.options.lights | default([]) %}
  - id: regie_{{ area.id }}_{{ m.id }}_motion_light
    alias: {{ (area.label ~ ' — ' ~ (m.label | default(labels.kind('motion'))) ~ ' → ' ~ labels.ui.lights) | to_yaml }}
    description: a motion light (La Régie, pack lighting — home.yml, not the UI)
    mode: restart
    triggers:
      - trigger: state
        entity_id: {{ entity(m) }}
        to: "on"
{% if m.options.only_at_night | default(false) %}
    conditions:
      - condition: sun
        after: sunset
        before: sunrise
{% else %}
    conditions: []
{% endif %}
    actions:
      - action: light.turn_on
        target:
          entity_id:
{% for id in targets %}
            - {{ entity(house.thing(id)) }}
{% else %}
            - light.{{ area.id }}_lights
{% endfor %}
      - wait_for_trigger:
          - trigger: state
            entity_id: {{ entity(m) }}
            to: "off"
      - delay: {{ m.options.off_after | default('00:05:00') | to_yaml }}
      - action: light.turn_off
        target:
          entity_id:
{% for id in targets %}
            - {{ entity(house.thing(id)) }}
{% else %}
            - light.{{ area.id }}_lights
{% endfor %}
{% endfor %}
{% if controls.restore_default and kinds.get('light', []) %}
  # a light back from power takes the room's DEFAULT look, never its last
  # state (controls.restore_default, W3b: "default on first startup")
  - id: regie_{{ area.id }}_restore_default
    alias: {{ (area.label ~ ' — ' ~ labels.ui.default) | to_yaml }}
    description: a light of this room came back from power (the wall switch, an outage) — the room takes its default look (La Régie, controls.restore_default)
    mode: restart
    triggers:
{% for t in kinds.get('light', []) if entity(t) %}
      - trigger: state
        entity_id: {{ entity(t) }}
        from: unavailable
        to: 'on'
{% endfor %}
    actions:
      - action: script.turn_on
        target:
          entity_id: script.{{ area.id }}_default
{% endif %}
{% if controls.silent %}
  - id: regie_{{ area.id }}_silent
    alias: {{ (area.label ~ ' — ' ~ labels.ui.silent) | to_yaml }}
    description: a thing of this room unavailable for an hour (La Régie, pack lighting)
    mode: queued
    triggers:
      - trigger: state
        entity_id:
{% for t in watched if entity(t) %}
          - {{ entity(t) }}
{% endfor %}
        to: unavailable
        for: "01:00:00"
    actions:
      - action: persistent_notification.create
        data:
          notification_id: "regie_silent_{{ '{{ trigger.entity_id }}' }}"
          title: {{ area.label | to_yaml }}
          message: "{{ '{{ trigger.to_state.name }}' }} {{ labels.ui.silent }}"
{% endif %}
{% endif %}
{% endif %}
