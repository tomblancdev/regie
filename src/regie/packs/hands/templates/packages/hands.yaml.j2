{% set remotes = hands_plan(area) %}
{% if remotes %}
# rendered by La Régie — {{ area.label }}: the hands (pack hands — rooms/{{ area.id }}.yml, not the UI)
# One automation per remote, its gestures as branches; restart mode, so the
# next gesture (a release included) ends a hold. A remote is a hand: no switch.
# A wheel's turns beside it (0.47): heard notch by notch from the component's
# ear, queued so that no step is cancelled mid-command.
automation:
{% for r in remotes %}
{{ [r.automation] | to_block(0) }}
{% if r.turns %}
{{ [r.turns] | to_block(0) }}
{% endif %}
{% endfor %}
{% endif %}
