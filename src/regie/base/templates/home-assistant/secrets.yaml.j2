# rendered by La Régie — the values come from the house's store, never from home.yml
mqtt_password: {{ secrets['mqtt_password_home'] | to_yaml }}
{% if data.oidc is defined %}
oidc_client_secret: {{ secrets['oidc_client_secret'] | to_yaml }}
{% endif %}
{% set assist = house.assist() %}
{% if assist and assist.ceiling %}
{# the watchman's client token as the whole header a rest_command sends (pack assist) #}
{{ assist.ceiling.watchman.token }}_bearer: {{ ('Bearer ' ~ secrets[assist.ceiling.watchman.token]) | to_yaml }}
{% endif %}
