# rendered by La Régie — the values come from the house's store.
# The file Zigbee2MQTT's value references point at ("!secret <key>" in
# configuration.yaml), and the only two it will take one for: the broker
# password and the network key. It writes this file too (it puts a changed
# value back through the same reference), so the render is the baseline and
# the mode is 0600.
mqtt_password: {{ secrets['mqtt_password_zigbee2mqtt_' ~ coordinator.id] | to_yaml }}
network_key: {{ secrets['zigbee_' ~ coordinator.id ~ '_network_key'] | to_yaml }}
