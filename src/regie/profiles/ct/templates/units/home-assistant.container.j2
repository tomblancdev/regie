# rendered by La Régie — edit home.yml, not this file
[Unit]
Description=Home Assistant — the brain
After=network-online.target mosquitto.service{{ ' matter-server.service' if house.has_pack('matter') else '' }}
Wants=network-online.target

[Container]
Image={{ images.home_assistant }}:{{ pins.home_assistant }}
ContainerName=home-assistant
Network=host
Volume={{ root }}/home-assistant:/config:Z
Volume=/etc/localtime:/etc/localtime:ro
Environment=TZ={{ data.house.timezone | default('UTC') }}
# the brain's shutdown (the recorder's last write, every integration's stop)
# outlives podman's default 10 s: killed there, the recorder opens its next
# run on an unfinished session. 60 s of grace, under systemd's 90 s
# TimeoutStopSec (the default this profile keeps). podman bakes the value into
# the container at its creation: a change here lands at the restart AFTER
# the one that places it
StopTimeout=60

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
